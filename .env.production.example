# Copy to .env.production. Generate each secret with: openssl rand -hex 32
# Use hex secrets, because they go into connection URLs and can't contain special characters.
DB_NAME=shortlist
DB_USER=shortlist
DB_PASSWORD=
REDIS_PASSWORD=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-domain.example

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

IMAGE_TAG=latest
